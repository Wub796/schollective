{
  "name": "schollective-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "if [ -n \"$NEXT_PRIVATE_STANDALONE\" ]; then next build; else opennextjs-cloudflare build; fi",
    "start": "next start",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint",
    "build:cf": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cf": "opennextjs-cloudflare build && wrangler deploy",
    "preview:cf": "opennextjs-cloudflare build && wrangler dev"
  },
  "dependencies": {
    "@amplitude/ai": "^0.16.0",
    "@amplitude/unified": "^1.1.31",
    "@google/genai": "^2.16.0",
    "@neon/config": "^1.1.0",
    "@neondatabase/serverless": "0.10.4",
    "@opennextjs/cloudflare": "^1.20.4",
    "@sentry/nextjs": "^10.73.0",
    "@types/pg": "^8.23.1",
    "better-auth": "^1.7.2",
    "clsx": "^2.1.1",
    "framer-motion": "^11.18.0",
    "kysely": "^0.29.5",
    "lucide-react": "^1.14.0",
    "next": "^15.5.16",
    "posthog-js": "^1.422.5",
    "posthog-node": "^4.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "three": "^0.160.0",
    "wrangler": "^4.127.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.160.0",
    "eslint": "^9",
    "eslint-config-next": "^15.5.16",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
