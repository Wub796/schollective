# Schollective — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.
# Every value below is a placeholder — real credentials live only in .env.local
# (untracked) and Cloudflare Worker secrets (`npx wrangler secret put …`).

# ── Database (Neon) ─────────────────────────────────────────────────────────
# Pooled connection string from the Neon Console "Connect" panel.
# Reset this password immediately if it ever reaches git or chat.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxx-pooler.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Same endpoint without the -pooler segment (needed by the serverless HTTP driver).
DATABASE_URL_UNPOOLED="postgresql://neondb_owner:PASSWORD@ep-xxxx.c-2.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ── Auth (Better Auth) ──────────────────────────────────────────────────────
# 32+ random bytes: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
BETTER_AUTH_SECRET="generate-a-new-random-secret"
BETTER_AUTH_URL="https://schollective.com"

# ── Google OAuth ────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client.
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-client-secret"

# ── AI (Google Gemini) ──────────────────────────────────────────────────────
GEMINI_API_KEY="your-gemini-api-key"

# ── Object storage (Neon S3-compatible) ────────────────────────────────────
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_ENDPOINT_URL_S3="https://your-bucket-host.storage.c-2.us-east-2.aws.neon.tech"
AWS_REGION="us-east-2"

# ── Email (Resend) ──────────────────────────────────────────────────────────
# Used on the Worker as a secret; locally only if you send email in dev.
# Both are required for anything to be delivered at all: without either one,
# every message (password reset, verification, feedback, safety) is logged to the
# Worker console instead of sent. EMAIL_FROM must be on a domain verified in
# Resend, and is the literal header, e.g. "Schollective <notifications@domain>".
# RESEND_API_KEY="re_your-key"
# EMAIL_FROM="Schollective <notifications@schollective.com>"
# Where beta feedback notifications go. Optional: without it, reports still land
# in /admin/feedback and only the heads-up email is skipped.
# FEEDBACK_EMAIL_TO="team@schollective.com"
# Where youth-protection safety reports are emailed. Strongly recommended, and
# the mailbox has to be monitored: a report about a minor landing only in
# /admin/safety is a report nobody is told about, and the public policy names
# this address. Without it the safety page says so out loud.
# SAFETY_EMAIL_TO="safety@schollective.com"

# ── Analytics (client-side, public by design) ──────────────────────────────
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN="phc_your-posthog-token"
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
NEXT_PUBLIC_AMPLITUDE_API_KEY="your-amplitude-key"

# ── App URL ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="https://schollective.com"

# Legacy Neon Auth endpoints — kept only if still referenced; delete if unused.
# NEON_AUTH_BASE_URL="https://ep-xxxx.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth"
# NEON_AUTH_JWKS_URL="https://ep-xxxx.neonauth.c-2.us-east-2.aws.neon.tech/neondb/auth/.well-known/jwks.json"
